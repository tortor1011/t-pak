# ─── Database ──────────────────────────────────────────────────
# Pooled connection URL used by Prisma at runtime (e.g. PgBouncer / Supabase pooler)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?pgbouncer=true"

# Direct (non-pooled) connection URL used by Prisma Migrate / seed
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DB"

# ─── Auth.js (NextAuth v5) ─────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"

# ─── Cross-Origin Resource Sharing ────────────────────────────
# Full URL of the Tenant app in production (must include protocol, no trailing slash)
# Example: https://tenant.yourdomain.com
TENANT_APP_URL=
